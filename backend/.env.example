ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_sql_assistant
DATABASE_STATEMENT_TIMEOUT_MS=5000
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0
ENABLE_AI_SUMMARY=true
MAX_QUERY_LIMIT=100
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
